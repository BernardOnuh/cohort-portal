generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Cohort {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  courses            Course[]
  students           User[]
  materials          Material[]
  assignments        Assignment[]
  assessments        Assessment[]
  attendances        Attendance[]
  attendanceSessions AttendanceSession[]
  curriculum         Curriculum[]
  payments           Payment[]
}

model Course {
  id        String   @id @default(cuid())
  name      String
  cohortId  String
  createdAt DateTime @default(now())

  cohort      Cohort              @relation(fields: [cohortId], references: [id])
  admins      User[]              @relation("CourseAdmins")
  students    User[]              @relation("CourseStudents")
  materials   Material[]
  assignments Assignment[]
  assessments Assessment[]
  sessions    AttendanceSession[]
  curriculum  Curriculum[]
  payments    Payment[]

  @@unique([name, cohortId])
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("STUDENT")
  cohortId  String?
  courseId  String?
  createdAt DateTime @default(now())

  cohort            Cohort?            @relation(fields: [cohortId], references: [id])
  adminCourse       Course?            @relation("CourseAdmins", fields: [courseId], references: [id])
  studentCourse     Course?            @relation("CourseStudents", fields: [courseId], references: [id])
  submissions       Submission[]
  assessmentResults AssessmentResult[]
  attendances       Attendance[]
  payment           Payment?
}

model Curriculum {
  id          String   @id @default(cuid())
  courseId    String
  cohortId    String
  week        Int
  title       String
  description String?
  createdAt   DateTime @default(now())

  course     Course      @relation(fields: [courseId], references: [id])
  cohort     Cohort      @relation(fields: [cohortId], references: [id])
  assignment Assignment?
  materials  Material[]

  @@unique([courseId, cohortId, week])
}

model Material {
  id            String   @id @default(cuid())
  title         String
  cloudinaryUrl String
  publicId      String
  type          String
  cohortId      String
  courseId      String
  curriculumId  String?
  uploadedAt    DateTime @default(now())

  cohort     Cohort      @relation(fields: [cohortId], references: [id])
  course     Course      @relation(fields: [courseId], references: [id])
  curriculum Curriculum? @relation(fields: [curriculumId], references: [id])
}

model AttendanceSession {
  id        String   @id @default(cuid())
  cohortId  String
  courseId  String
  date      DateTime
  allowedIp String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  cohort      Cohort       @relation(fields: [cohortId], references: [id])
  course      Course       @relation(fields: [courseId], references: [id])
  attendances Attendance[]
}

model Attendance {
  id        String   @id @default(cuid())
  studentId String
  cohortId  String
  sessionId String
  date      DateTime
  status    String   @default("PRESENT")
  ip        String

  student User              @relation(fields: [studentId], references: [id])
  cohort  Cohort            @relation(fields: [cohortId], references: [id])
  session AttendanceSession @relation(fields: [sessionId], references: [id])

  @@unique([studentId, sessionId])
}

model Assignment {
  id                     String   @id @default(cuid())
  title                  String
  description            String
  questionText           String?
  questionDocUrl         String?
  allowedSubmissionTypes String   @default("[\"pdf\",\"doc\",\"url\",\"image\",\"video\",\"code\"]")
  curriculumId           String   @unique
  cohortId               String
  courseId               String
  openAt                 DateTime
  closeAt                DateTime
  createdAt              DateTime @default(now())

  curriculum  Curriculum   @relation(fields: [curriculumId], references: [id])
  cohort      Cohort       @relation(fields: [cohortId], references: [id])
  course      Course       @relation(fields: [courseId], references: [id])
  submissions Submission[]
}

model Submission {
  id             String   @id @default(cuid())
  studentId      String
  assignmentId   String
  submissionType String   @default("file")
  cloudinaryUrl  String?
  publicId       String?
  contentUrl     String?
  submittedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
  grade          Int?
  feedback       String?

  student    User       @relation(fields: [studentId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id])

  @@unique([studentId, assignmentId])
}

model Assessment {
  id             String   @id @default(cuid())
  title          String
  type           String
  cohortId       String
  courseId       String
  dueDate        DateTime
  questions      String
  correctAnswers String   @default("[]")
  questionText   String?
  createdAt      DateTime @default(now())

  cohort  Cohort             @relation(fields: [cohortId], references: [id])
  course  Course             @relation(fields: [courseId], references: [id])
  results AssessmentResult[]
}

model AssessmentResult {
  id             String   @id @default(cuid())
  studentId      String
  assessmentId   String
  answers        String
  submissionType String   @default("file")
  cloudinaryUrl  String?
  publicId       String?
  contentUrl     String?
  score          Int?
  submittedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student    User       @relation(fields: [studentId], references: [id])
  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@unique([studentId, assessmentId])
}

model Payment {
  id          String    @id @default(cuid())

  studentId   String    @unique
  cohortId    String
  courseId    String

  // PENDING | INSTALMENT_1_PAID | COMPLETED
  status      String    @default("PENDING")

  amountPaid  Float     @default(0)
  monnifyRef  String?

  pendingRef  String?
  pendingType String?

  lastPaidAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cohort      Cohort    @relation(fields: [cohortId],  references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId],  references: [id], onDelete: Cascade)

  @@index([cohortId])
  @@index([courseId])
  @@index([status])
  @@index([pendingRef])
}
