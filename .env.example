# Web3Nova — production / shared template
# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── Server ────────────────────────────────────────────────────
PORT=3012
# Comma-separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=https://your-frontend.com

# ── Database (Turso) ──────────────────────────────────────────
# Local dev alternative: TURSO_DATABASE_URL=file:./dev.db  (TURSO_AUTH_TOKEN blank)
TURSO_DATABASE_URL=https://<db-name>-<org>.db.turso.io
TURSO_AUTH_TOKEN=<turso auth token>

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=<openssl rand -hex 32>

# ── Cloudinary ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<cloud name>
CLOUDINARY_API_KEY=<api key>
CLOUDINARY_API_SECRET=<api secret>

# ── Monnify ───────────────────────────────────────────────────
# sandbox: https://sandbox-api.monnify.com   live: https://api.monnify.com
MONNIFY_BASE_URL=https://api.monnify.com
MONNIFY_API_KEY=<monnify api key>
MONNIFY_SECRET_KEY=<monnify secret key>
MONNIFY_CONTRACT_CODE=<contract code>
MONNIFY_REDIRECT_URL=https://your-api/payments/return

# ── Admin seed ────────────────────────────────────────────────
ADMIN_EMAIL=admin@web3nova.org
ADMIN_PASSWORD=<strong password>
ADMIN_NAME=Web3Nova Admin
